# Copy this file to .env and adjust as needed.

# URL of the SafeStreet AI backend's API (see /backend). This is where the
# frontend sends images, camera frames, and audio segments for real AI
# analysis — nothing is generated client-side.
VITE_API_BASE_URL=http://localhost:5000/api

# EmailJS credentials — get these from https://www.emailjs.com/ after
# creating a service + template. See src/emails/EMAIL_TEMPLATE.md.
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
