# Copy this file to .env and adjust paths/thresholds as needed.

# Path to your custom-trained weapon detection weights (knife, pistol, gun...).
# Place the file at ai_service/models/best.pt (or point this elsewhere).
WEAPON_MODEL_PATH=models/best.pt

# Path to the person-detection model. Leave as the bare filename and
# Ultralytics will auto-download the official yolov8n.pt on first run
# (cached afterwards). Point this at models/yolov8n.pt if you'd rather
# keep a local copy alongside best.pt.
PERSON_MODEL_PATH=yolov8n.pt

# Detection confidence thresholds (0.0 - 1.0)
WEAPON_CONFIDENCE_THRESHOLD=0.35
PERSON_CONFIDENCE_THRESHOLD=0.40

# faster-whisper settings. "tiny.en" + int8 is the lightest usable
# combination for low-end CPUs; try "base.en" for better accuracy if
# your machine can handle it.
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Origin(s) allowed to call this service — your Express backend, not the
# browser directly.
CORS_ORIGIN=http://localhost:5000

PORT=6000
